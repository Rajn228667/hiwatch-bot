# HiWatch Settings Bot — Environment Variables
# Copy to .env and fill in your values

# Telegram bot token (from @BotFather)
BOT_TOKEN=your-bot-token-from-botfather

# Admin usernames (comma-separated, without @)
ADMIN_USERNAMES=STPierce,Who_Knyaz

# Admin chat IDs (comma-separated, get via /id command)
ADMIN_CHAT_IDS=

# Webhook URL for 24/7 hosting (Koyeb)
# Leave empty for local dev (uses polling)
# For Koyeb: https://your-app-name.koyeb.app
WEBHOOK_URL=

# Port (Koyeb uses 10000)
PORT=10000

# Hikmart website integration
# Orders from bot are pushed to the website manager panel
HIKMART_API_URL=https://hikmart.vercel.app
HIKMART_BOT_TOKEN=hikmart-bot-sync-2025
